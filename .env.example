# EvoMemState reproduction endpoints. Copy to .env and fill in credentials.
MEMORY_API_KEY=
MEMORY_BASE_URL=
MEMORY_LLM_MODEL=deepseek-v4-flash

# Answer model
GEN_B_MODEL=qwen3-8b
GEN_B_BASE_URL=http://127.0.0.1:8800/v1
GEN_B_API_KEY=EMPTY

# Judge model
JUDGE_MODEL=deepseek-v4-flash
JUDGE_BASE_URL=
JUDGE_API_KEY=

# Reasoning State inference endpoint
EVOMEMSTATE_REASONING_STATE_ENABLED=1
REASONING_STATE_MODEL=
REASONING_STATE_BASE_URL=
REASONING_STATE_API_KEY=EMPTY

# Optional retrieval embedding
EMBEDDING_API_KEY=
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_DIMS=1024

WORKERS=4
PREBUILD_WORKERS=4
TOP_K=10
